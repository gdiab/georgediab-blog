---
/**
 * Click-to-enlarge for images inside the post body (`#article`).
 *
 * Progressive enhancement over a native <dialog>: without JS the images are
 * plain images; with JS each one becomes a button that opens the full-size
 * file in a modal. Esc, the close button, and a click on the backdrop dismiss.
 */
---

<dialog
  data-lightbox
  class="lightbox"
  aria-label="Enlarged image"
>
  <button
    type="button"
    class="lightbox-close focus-outline"
    data-lightbox-close
    aria-label="Close enlarged image"
  >
    &times;
  </button>
  <figure class="lightbox-figure">
    <img data-lightbox-img alt="" decoding="async" />
    <figcaption data-lightbox-caption hidden></figcaption>
  </figure>
</dialog>

<style>
  .lightbox {
    /* Reset the UA dialog box so the figure controls the size. */
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.82);
  }

  .lightbox[open] {
    animation: lightbox-in 160ms ease-out;
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox[open] {
      animation: none;
    }
  }

  .lightbox-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
  }

  .lightbox-figure img {
    display: block;
    max-width: min(96vw, 1600px);
    max-height: 88vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 0.375rem;
    background: var(--background);
  }

  .lightbox-figure figcaption {
    max-width: 70ch;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.4;
    color: #e6e4da;
  }

  .lightbox-close {
    position: fixed;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.25);
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox-close:hover {
    background: rgb(0 0 0 / 0.8);
  }

  /* Keep the page from scrolling behind the modal. */
  :global(body:has(dialog[data-lightbox][open])) {
    overflow: hidden;
  }

  /* Affordance on the source images once JS has wired them up. */
  :global(#article img[data-lightbox-src]) {
    cursor: zoom-in;
  }
</style>

<script>
  function initImageLightbox() {
    const dialog = document.querySelector<HTMLDialogElement>("dialog[data-lightbox]");
    const article = document.querySelector<HTMLElement>("#article");
    if (!dialog || !article) return;

    // ViewTransitions fires `astro:page-load` on initial load too. The dialog is
    // part of the swapped page, so a fresh element means fresh wiring; an
    // already-wired one means we are done.
    if (dialog.dataset.lightboxReady) return;
    dialog.dataset.lightboxReady = "true";

    const enlarged = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]");
    const caption = dialog.querySelector<HTMLElement>("[data-lightbox-caption]");
    const closeButton = dialog.querySelector<HTMLButtonElement>("[data-lightbox-close]");
    if (!enlarged || !caption || !closeButton) return;

    let opener: HTMLElement | null = null;

    function open(source: HTMLImageElement) {
      opener = source;
      enlarged!.src = source.currentSrc || source.src;
      enlarged!.alt = source.alt;
      const text = source.alt.trim();
      caption!.textContent = text;
      caption!.hidden = text.length === 0;
      dialog!.showModal();
      closeButton!.focus();
    }

    // Release the large image and hand focus back to the thumbnail. Idempotent,
    // because it is reachable from more than one path below.
    function cleanup() {
      enlarged!.removeAttribute("src");
      opener?.focus();
      opener = null;
    }

    function close() {
      dialog!.close();
      cleanup();
    }

    // Esc closes natively. Chrome 153 was observed not dispatching `close` on
    // <dialog>, but it does dispatch `toggle`; older browsers do the reverse.
    // Listen to both; cleanup is idempotent.
    dialog.addEventListener("close", cleanup);
    dialog.addEventListener("toggle", (event) => {
      if ((event as ToggleEvent).newState === "closed") cleanup();
    });

    closeButton.addEventListener("click", close);

    // A click on the dialog element itself (not its children) is the backdrop.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });

    const images = article.querySelectorAll<HTMLImageElement>(
      "img:not([data-lightbox-skip])",
    );
    images.forEach((img) => {
      // Images already inside a link keep their link.
      if (img.closest("a")) return;

      img.dataset.lightboxSrc = img.currentSrc || img.src;
      img.tabIndex = 0;
      img.setAttribute("role", "button");
      img.setAttribute(
        "aria-label",
        img.alt ? `View larger: ${img.alt}` : "View larger image",
      );

      img.addEventListener("click", () => open(img));
      img.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          open(img);
        }
      });
    });
  }

  initImageLightbox();
  document.addEventListener("astro:page-load", initImageLightbox);
</script>
